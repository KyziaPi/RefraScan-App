# RefraScan App .env Template
# Copy this file as '.env' inside the RefraScan folder and fill in your values

# ========================================
# DATABASE CONFIGURATION
# ========================================

# Database name (default: refrascan_db)
DB_NAME=refrascan_db

# PostgreSQL username (default: postgres)
DB_USER=postgres

# PostgreSQL password (change to your password!)
DB_PASSWORD=your_password_here

# Database host
# For LOCAL only:   127.0.0.1 or localhost
# For NETWORK:      Server IP address (e.g., 192.168.1.100)
DB_HOST=127.0.0.1

# PostgreSQL port (default: 5432)
DB_PORT=5432

# ========================================
# NETWORK SHARED FOLDER (Optional)
# ========================================

# Leave empty to use local uploads folder
# For network shared folder, use mapped drive or UNC path
# Examples:
#   Z:\                          (mapped network drive)
#   \\192.168.1.100\uploads\     (UNC path with IP)
#   \\SERVER-PC\uploads\         (UNC path with computer name)
UPLOAD_BASE_PATH=

# ========================================
# NOTES
# ========================================
# - Keep this file in the RefraScan app root directory
# - Never commit this to version control (contains passwords!)
# - For network setup: update DB_HOST and UPLOAD_BASE_PATH
# - Make sure network paths end with backslash
# - Database must be created first before app starts
